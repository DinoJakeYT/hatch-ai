{
  "name": "hatch",
  "productName": "Hatch",
  "version": "1.0.0",
  "description": "A desktop app where Claude, ChatGPT, Gemini and local models build things in your project folders, alone or as a team.",
  "author": "DinoJakeYT",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/DinoJakeYT/hatch-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/DinoJakeYT/hatch-ai.git"
  },
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "icon": "electron tools/make-icon.mjs",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@google/gemini-cli": "0.65.0",
    "@openai/codex": "0.164.0",
    "@openai/codex-sdk": "0.164.0",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.11",
    "marked": "18.1.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.dinojakeyt.hatch",
    "productName": "Hatch",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.mjs",
      "preload.cjs",
      "lib/**",
      "engines/**",
      "renderer/**",
      "assets/**",
      "templates/**",
      "tools/**",
      "remote/**",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/hatch.ico",
      "artifactName": "Hatch-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Hatch",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "DinoJakeYT",
      "repo": "hatch-ai"
    }
  }
}
